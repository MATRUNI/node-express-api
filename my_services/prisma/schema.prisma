generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("NEON_DB")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String

  isVerified Boolean @default(false)

  hashedRefreshToken String?  @unique
  
  stats Json @default("{}")

  lastLogin DateTime?
  createdAt DateTime  @default(now())

  sharedDataOwned    SharedData[]
  sharedDataReceived SharedDataRecipient[]
}

model SharedData {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  data    String
  message String?
  version Int   @default(1)

  expiresAt DateTime
  
  recipients SharedDataRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model SharedDataRecipient {
  sharedDataId String
  userId       String

  sharedData SharedData @relation(fields: [sharedDataId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sharedDataId, userId])
  @@index([userId])
}
